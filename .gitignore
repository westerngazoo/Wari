# Build artifacts
**/target/
/build/*
!/build/.gitkeep
# Exception: the deploy artifact must be committed so the VF2 can pull
# it via `wari go` (matches goose-os's deploy pattern).
!/build/wari.release

# rustc crash dumps — R8 says reproducible builds, ICE dumps are not
rustc-ice-*.txt

# HappyDev-internal process notes. Deliberately NOT tracked: this repo is
# AGPL and mirrored publicly, and that file names internal hosts, vault
# paths and the credentials file. The vault is its authority; this is a
# local convenience copy so the agent loads it automatically.
CLAUDE.local.md

# Editor / OS noise
.vscode/
.idea/
*.swp
.DS_Store

# QEMU runtime debris
*.pcap
*.img.tmp

# PR body scratch (written by agent, consumed by `gh pr create` or web UI)
/pr-body.md
/pr*-body.md
